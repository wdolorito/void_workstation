#!/bin/sh

#
# ~/local/bin/sys_update
#

SUDO="$(which sudo 2>/dev/null)"
XBINST="xbps-install"
XBREM="xbps-remove"

do_system_update() {
	echo "Updating the Void..."
	$SUDO "$XBINST" -Syu xbps
	$SUDO "$XBINST" -yu
	$SUDO "$XBREM" -RyoO
}

if [ -z "$SUDO" ]
then
	echo "sudo command not available."
	exit 127
else
	do_system_update
	flatpak_update
	remove_kernels
fi
