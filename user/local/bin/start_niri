#!/bin/sh

#
# ~/local/bin/start_niri
#

BACKGROUND="$HOME/Pictures/<image>"
OBSOCK="$(make_ob_sock 2>/dev/null)"
QT_QPA_PLATFORM="wayland"
MOZ_ENABLE_WAYLAND=1
NIRI="$(which niri 2>/dev/null)"
DSESS="$(which dbus-run-session)"

run_session() {
	if [ -n "$NIRI" ]
	then
		export OBSOCK
		export QT_QPA_PLATFORM
		export MOZ_ENABLE_WAYLAND
		bright 30 false
		cd "$HOME" || exit
		$DSESS -- "$NIRI" --session
	else
		echo "niri command not available."
		exit 127
	fi
}

reset_env() {
	make_ob_sock destroy 2>/dev/null
	do_ob clean 2>/dev/null
	unset OBSOCK
	unset QT_QPA_PLATFORM
	unset MOZ_ENABLE_WAYLAND
	clear
}

set_background() {
	swaybg -i "$BACKGROUND" 2>/dev/null
}

set_idle() {
	lock_session reset 2>/dev/null
	swayidle -w \
		timeout 300 'lock_session' \
		timeout 600 'niri msg action power-off-monitors' \
		timeout 1200 'hybrid-sleep' 2>/dev/null
}

case "$1" in
	idle )
		set_idle
		;;
	background )
		set_background
		;;
	* )
		run_session
		reset_env
		;;
esac
