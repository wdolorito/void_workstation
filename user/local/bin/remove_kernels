#!/bin/sh

#
# ~/local/bin/remove_kernels
#

SUDO="$(which sudo 2>/dev/null)"
CMD="vkpurge"

check_kernels() {
	echo "Checking installed kernels..."
	KERNLIST="$($SUDO "$CMD" list)"
}

remove_kernels() {
	echo "Removing all previous kernels..."
	$SUDO "$CMD" rm all
}

if [ -z "$SUDO" ]
then
	echo "sudo command not available."
	exit 127
else
	check_kernels
	if [ -n "$KERNLIST" ]
	then
		remove_kernels
	fi
fi
