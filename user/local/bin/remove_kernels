#!/bin/sh

#
# ~/local/bin/remove_kernels
#

SUDO="$(which sudo 2>/dev/null)"
CMD="$(which vkpurge 2>/dev/null)"
EXTRAK=0

check_kernels() {
	if [ -z "$1" ]
	then
		echo "Checking installed kernels..."
	fi
	KERNLIST="$($CMD list)"
	EXTRAK="$(echo ${KERNLIST} | wc -w)"
}

remove_kernels() {
	while [ "$EXTRAK" -ne 1 ]
	do
		PKERN="$(echo $KERNLIST | awk -F " " '{print $1}')"
		echo "Removing previous kernel... " "$PKERN"
		$SUDO "$(basename ${CMD})" rm "$PKERN"
		check_kernels next
	done
}

if [ -z "$SUDO" ]
then
	echo "sudo command not available."
	exit 127
else
	if [ -z "$CMD" ]
	then
		echo "vkpurge command not available."
		exit 127
	fi

	check_kernels
	remove_kernels
fi
